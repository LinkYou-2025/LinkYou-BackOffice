# 백엔드(API Gateway) 주소. 끝의 슬래시는 없어도 됩니다.
VITE_API_BASE_URL=https://xxxx.execute-api.ap-northeast-2.amazonaws.com

# GitHub OAuth App의 Client ID (Client Secret은 프론트에 두지 않습니다 — Lambda에만 보관)
VITE_GITHUB_CLIENT_ID=

# true 이면 API/로그인을 브라우저 안의 mock 으로 대체합니다. (배포 빌드에서는 켜지 마세요)
VITE_USE_MOCK=false

# dev 서버 스위치 API(로그인 없음, ?secret= 방식)를 쓰려면 switch 로 둡니다. 비우면 기존 API(GitHub 로그인 + JWT).
# 주의: VITE_ 변수는 빌드 결과물(JS)에 그대로 들어가므로 secret 이 브라우저에 노출됩니다.
VITE_API_MODE=
VITE_SWITCH_SECRET=
